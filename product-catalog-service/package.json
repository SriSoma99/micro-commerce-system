{
  "name": "product-catalog-service",
  "version": "1.0.0",
  "description": "Resilient product catalog microservice with circuit-breaker-protected data access.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "microservice",
    "express",
    "typescript",
    "circuit-breaker",
    "opossum"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "opossum": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/opossum": "^8.1.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
