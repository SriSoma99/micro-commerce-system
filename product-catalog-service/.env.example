PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# Probability (0-1) that the mock repository simulates a downstream failure.
# Raise this to observe the circuit breaker trip OPEN and serve fallback data.
DB_SIMULATED_FAILURE_RATE=0.25

# Upper bound (ms) of the random 100ms..N latency the mock datastore injects on
# every catalog read (default 1900). Use 0 for a snappy demo; keep the default
# to feel the slow-downstream behaviour the circuit breaker exists for.
# DB_SIMULATED_LATENCY_MAX_MS=1900

# Where the install-time store config (region, tax, payment modules, stores)
# is persisted. Defaults to ./data/store.config.json. Holds module ids only -
# never credentials.
# STORE_CONFIG_PATH=./data/store.config.json

# SQLite database file (customers, addresses, sessions; orders/inventory later).
# Defaults to ./data/app.db. Use ":memory:" for a throwaway in-memory database.
# DATABASE_PATH=./data/app.db

# Seed ~27 synthetic customers into an EMPTY customers table on boot (default on).
# Every synthetic account uses the password Demo@1234 - see CLAUDE.md.
# Set to "false" for any real deployment.
# SEED_SYNTHETIC_DATA=true


# Local dummy payment gateway (the payment-simulator service).
# PAYMENT_GATEWAY_URL is server-to-server; PAYMENT_GATEWAY_PUBLIC_URL is what the browser
# calls to tokenize card details (defaults to PAYMENT_GATEWAY_URL). The keys are dummies.
# PAYMENT_GATEWAY_URL=http://localhost:5002
# PAYMENT_GATEWAY_PUBLIC_URL=http://localhost:5002
# PAYMENT_GATEWAY_SECRET_KEY=sk_test_dummy
# PAYMENT_GATEWAY_PUBLISHABLE_KEY=pk_test_dummy

# One-time token required by POST /api/setup/install while the store is not
# installed. If unset, a random one is generated and printed in the server log
# at boot. Set it explicitly for Docker/CI where you can't read the log.
# SETUP_TOKEN=
