HOST=0.0.0.0
PORT=5002
# Browsers may call /v1/tokens from these origins (the storefront).
CORS_ORIGIN=*
# Dummy API keys, Stripe-style: the publishable key is safe in the browser (tokenize only);
# the secret key is for the shop backend (charge / capture / refund). Change both for any shared demo.
PAYMENT_SIM_PUBLISHABLE_KEY=pk_test_dummy
PAYMENT_SIM_SECRET_KEY=sk_test_dummy
# Delay (ms) added to every call so a demo checkout feels like a real processor.
# PAYMENT_SIMULATION_LATENCY_MS=500
